{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nikon Connector",
  "version": "0.1.6",
  "identifier": "com.shouyong.nikonconnector",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nikon Connector",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1QkJEQTFFRUM2NDJENDAKUldSQUxXVHNIdHE3Tlp0S0NzRVc1SzA4eVovYVZyQXBHbURrR0VvNWwzOWRvWUkrWU1NYm1RWjEK",
      "endpoints": [
        "https://github.com/Asplitline/nikon-connector/releases/latest/download/latest.json"
      ]
    }
  }
}
